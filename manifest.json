{
  "manifest_version": 3,
  "name": "AI Guardrails",
  "version": "0.1.0",
  "description": "Helps you use AI chatbots more intentionally",

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": [
        "guardrails/categories.js",
        "guardrails/storage.js",
        "guardrails/detector.js",
        "guardrails/actions.js",
        "guardrails/modals.js",
        "content.js"
      ],
      "css": ["modal.css"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["journal/journal.html", "journal/journal.js"],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ]
}
