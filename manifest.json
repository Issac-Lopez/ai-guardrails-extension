{
  "manifest_version": 3,
  "name": "AI Guardrails",
  "version": "0.1.0",
  "description": "Helps you use AI chatbots more intentionally",

  "permissions": [
    "storage"
  ],

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["journal.html", "journal.js"],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ]
    }
  ]
}
